[Unit]
Description=Vincent first boot bootstrap
After=local-fs.target
Before=vincent-console-status.service vincent-codex-console.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vincent-first-boot
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
